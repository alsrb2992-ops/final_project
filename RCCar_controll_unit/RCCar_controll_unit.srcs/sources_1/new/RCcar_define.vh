// 방향 : 정지, 직진, 후진, 좌회전, 우회전

`define RC_STOP 4'b0000

`define RC_FORWARD 4'b0001
`define RC_BACKWARD 4'b0010

`define RC_RIGHT 4'b0011
`define RC_LEFT 4'b0100

`define RC_BACKWARD_RIGHT 4'b0101
`define RC_BACKWARD_LEFT 4'b0110

`define RC_FORWARD_RIGHT 4'b0111
`define RC_FORWARD_LEFT 4'b1000

`define RC_TURN_RIGHT_BIG 4'b1001
`define RC_TURN_RIGHT_SMALL 4'b1010

`define RC_TURN_LEFT_BIG 4'b1011
`define RC_TURN_LEFT_SMALL 4'b1100


